using Microsoft.EntityFrameworkCore;
using Veilingklok.Core.Entities;
using Veilingklok.Core.Enums;
using Veilingklok.Infrastructure.Database;
using Veilingklok.Features.Auth.Services;

namespace Veilingklok.Infrastructure.Database.Seed;

public static class DbSeeder
{
    // Seed de database met basis accounts als de database nog leeg is
    public static async Task SeedAsync(MyContext db, PasswordService passwordService)
    {
        // Stopt als er al gebruikers bestaan, zodat je seed niet dubbel draait
        if (await db.Gebruikers.AnyAsync()) return;

        var now = DateTime.UtcNow;

        // Kleine helper om wachtwoorden te hashen
        string Hash(string pw) => passwordService.HashPassword(pw);

        // Maakt een vaste set testgebruikers aan
        var users = new List<Gebruiker>
        {

            // Maakt een admin user aan
            new() {
                Email = "DLS.admin@jemid.com",
                PasswordHash = Hash("Pass123!"),
                Rol = UserRole.Admin,
                Voornaam = "DLS",
                Achternaam = "Admin",
                CreatedAtUtc = now
            },

            // Maakt een aanvoerder user aan
            new() {
                Email = "sonia@veilingklok.local",
                PasswordHash = Hash("Pass123!"),
                Rol = UserRole.Aanvoerder,
                Voornaam = "Sonia",
                Achternaam = "Pasarga",
                CreatedAtUtc = now
            },

            // Maakt koper users aan
            new() {
                Email = "chris@veilingklok.local",
                PasswordHash = Hash("Pass123!"),
                Rol = UserRole.Koper,
                Voornaam = "Chris",
                Achternaam = "Shayan",
                CreatedAtUtc = now
            },

            new() {
                Email = "tristan@veilingklok.local",
                PasswordHash = Hash("Pass123!"),
                Rol = UserRole.Koper,
                Voornaam = "Tristan",
                Achternaam = "Perspolisi",
                CreatedAtUtc = now
            },

            new() {
                Email = "miriam@veilingklok.local",
                PasswordHash = Hash("Pass123!"),
                Rol = UserRole.Koper,
                Voornaam = "Miriam",
                Achternaam = "van de Hoeven",
                CreatedAtUtc = now
            }
        };

        // Slaat de gebruikers op in de database
        db.Gebruikers.AddRange(users);
        await db.SaveChangesAsync();

        // Maakt per gebruiker het bijpassende profiel (koper/aanvoerder/veilingmeester)
        foreach (var user in users)
        {
            switch (user.Rol)
            {
                case UserRole.Aanvoerder:
                    // Zet deze gebruiker ook in de Aanvoerders tabel
                    db.Aanvoerders.Add(new Aanvoerder
                    {
                        GebruikerId = user.Id,
                        Naam = $"{user.Voornaam} {user.Achternaam}"
                    });
                    break;

                case UserRole.Koper:
                    // Zet deze gebruiker ook in de Kopers tabel
                    db.Kopers.Add(new Koper
                    {
                        GebruikerId = user.Id,
                        Naam = $"{user.Voornaam} {user.Achternaam}"
                    });
                    break;

                case UserRole.Veilingmeester:
                    // Zet deze gebruiker ook in de Veilingmeesters tabel
                    db.Veilingmeesters.Add(new Veilingmeester
                    {
                        GebruikerId = user.Id,
                        Naam = $"{user.Voornaam} {user.Achternaam}"
                    });
                    break;

            }
        }

        // Slaat de profielen op in de database
        await db.SaveChangesAsync();
    }
}
