<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.2752196">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <!-- Allows the build (or compile) script located on package.json to run on Build -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- Folder where production build objects will be placed -->
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="src\core\context\**" />
    <None Remove="src\features\NewFolder1\**" />
    <None Remove="src\features\NewFolder\**" />
    <None Remove="src\features\veilingmeesterDashboard\api\**" />
    <None Remove="src\features\veilingmeesterDashboard\pages\**" />
    <None Remove="src\shared\layout\**" />
    <TypeScriptConfiguration Remove="src\core\context\**" />
    <TypeScriptConfiguration Remove="src\features\NewFolder1\**" />
    <TypeScriptConfiguration Remove="src\features\NewFolder\**" />
    <TypeScriptConfiguration Remove="src\features\veilingmeesterDashboard\api\**" />
    <TypeScriptConfiguration Remove="src\features\veilingmeesterDashboard\pages\**" />
    <TypeScriptConfiguration Remove="src\shared\layout\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\features\veilingmeesterDashboard\hooks\" />
    <Folder Include="src\features\veiling\hooks\" />
  </ItemGroup>
</Project>